    local Layout = Instance.new("UIListLayout")
    Layout.Padding = UDim.new(0, 12)
    Layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    Layout.Parent = Content

    -- Função de Toggle Estilizada
    local function CreateToggle(text, callback)
        local ToggleFrame = Instance.new("TextButton")
        ToggleFrame.Size = UDim2.new(0, 280, 0, 50)
        ToggleFrame.BackgroundColor3 = Theme.SecondaryBG
        ToggleFrame.Text = ""
        ToggleFrame.AutoButtonColor = false
        ToggleFrame.Parent = Content

        local TCorner = Instance.new("UICorner")
        TCorner.CornerRadius = UDim.new(0, 10)
        TCorner.Parent = ToggleFrame

        local TStroke = Instance.new("UIStroke")
        TStroke.Thickness = 1
        TStroke.Color = Theme.Border
        TStroke.Parent = ToggleFrame

        local Label = Instance.new("TextLabel")
        Label.Text = text
        Label.Size = UDim2.new(1, -60, 1, 0)
        Label.Position = UDim2.new(0, 15, 0, 0)
        Label.TextColor3 = Theme.Text
        Label.Font = Enum.Font.Gotham
        Label.TextSize = 15
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.BackgroundTransparency = 1
        Label.Parent = ToggleFrame

        local Status = Instance.new("TextLabel")
        Status.Text = "OFF"
        Status.Size = UDim2.new(0, 50, 0, 20)
        Status.Position = UDim2.new(1, -65, 0.5, -10)
        Status.TextColor3 = Theme.TextMuted
        Status.Font = Enum.Font.GothamBold
        Status.TextSize = 12
        Status.BackgroundTransparency = 1
        Status.Parent = ToggleFrame

        local state = false
        ToggleFrame.MouseButton1Click:Connect(function()
            state = not state
            callback(state)
            TStroke.Color = state and Theme.Accent or Theme.Border
            ToggleFrame.BackgroundColor3 = state and Color3.fromRGB(40, 30, 50) or Theme.SecondaryBG
            Status.Text = state and "ON" or "OFF"
            Status.TextColor3 = state and Theme.Accent or Theme.TextMuted
        end)
    end

    -- LÓGICAS OTIMIZADAS
    
    -- Auto Coin: Teleporte eficiente
    local function AutoCoinLogic(state)
        getgenv().Darkzin_AutoCoin = state
        task.spawn(function()
            while getgenv().Darkzin_AutoCoin do
                pcall(function()
                    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                    if not root then return end
                    
                    local count = 0
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if not getgenv().Darkzin_AutoCoin then break end
                        if count >= 20 then break end -- Limite de 20 por ciclo para performance
                        if count >= 1 then break end -- Limite de 1 por ciclo para evitar crash/ban
                        if v:IsA("BasePart") and (v.Name == "Coin" or v.Name:find("Coin")) then
                            v.CFrame = root.CFrame
                            count = count + 1
                        end
                    end
                end)
                task.wait(0.01) -- Velocidade máxima
            end
        end)
    end

    -- Hide Coins: Anti-Lag Real
    local function HideCoinsLogic(state)
        getgenv().Darkzin_HideCoins = state
        
        local function hide(v)
            if v:IsA("BasePart") and (v.Name == "Coin" or v.Name:find("Coin")) then
                v.Transparency = 1
                v.CanCollide = false
                v.CanTouch = false
                v.CanQuery = false
                for _, effect in pairs(v:GetDescendants()) do
                    if effect:IsA("ParticleEmitter") or effect:IsA("Trail") or effect:IsA("Sparkles") then
                        effect.Enabled = false
                    end
                end
            end
        end

        -- Conexão para moedas que spawnarem em tempo real
        local connection = Workspace.DescendantAdded:Connect(function(v)
            if getgenv().Darkzin_HideCoins then
                hide(v)
            end
        end)

        task.spawn(function()
            while getgenv().Darkzin_HideCoins do
                pcall(function()
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if not getgenv().Darkzin_HideCoins then break end
                        hide(v)
                    end
                end)
                task.wait(2) -- Loop de limpeza mais lento para evitar lag
            end
            if connection then connection:Disconnect() end
        end)
    end

    -- Auto Boss: Combate Automático
    local function AutoBossLogic(state)
        getgenv().Darkzin_AutoBoss = state
        task.spawn(function()
            while getgenv().Darkzin_AutoBoss do
                pcall(function()
                    for _, v in pairs(Workspace:GetDescendants()) do
                        if not getgenv().Darkzin_AutoBoss then break end
                        if v:IsA("Model") and (v.Name:find("Boss") or v:FindFirstChild("Humanoid")) then
                            local hum = v:FindFirstChildOfClass("Humanoid")
                            local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                            if hum and hum.Health > 0 and root then
                                root.CFrame = v.PrimaryPart and v.PrimaryPart.CFrame or v:FindFirstChildWhichIsA("BasePart").CFrame
                                local tool = LocalPlayer.Character:FindFirstChildOfClass("Tool")
                                if tool then tool:Activate() end
                            end
                        end
                    end
                end)
                task.wait(0.5)
            end
        end)
    end

    -- Adicionando Toggles
    CreateToggle("Auto Coletar Moedas", AutoCoinLogic)
    CreateToggle("Hide Moedas (Anti-Lag)", HideCoinsLogic)
    CreateToggle("Auto Matar Bosses", AutoBossLogic)
    CreateToggle("XP Boost (Multiplicador)", function(state)
        getgenv().Darkzin_XPBoost = state
        task.spawn(function()
            while getgenv().Darkzin_XPBoost do
                pcall(function()
                    -- Tenta encontrar valores de XP comuns em simuladores
                    for _, v in pairs(LocalPlayer:GetDescendants()) do
                        if v.Name:find("XP") or v.Name:find("Experience") then
                            if v:IsA("NumberValue") or v:IsA("IntValue") then
                                v.Value = v.Value + 1000
                            end
                        end
                    end
                end)
                task.wait(1)
            end
        end)
    end)

    -- Sistema de Arraste
    local dragging, dragInput, dragStart, startPos
    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Sistema de Minimizar
    local minimized = false
    MinBtn.MouseButton1Click:Connect(function()
        minimized = not minimized
        if minimized then
            Content.Visible = false
            MainFrame:TweenSize(UDim2.new(0, 320, 0, 50), "Out", "Quad", 0.3, true)
        else
            MainFrame:TweenSize(UDim2.new(0, 320, 0, 420), "Out", "Quad", 0.3, true)
            task.wait(0.3)
            Content.Visible = true
        end
    end)

    -- Botão Flutuante (DZ)
    local ToggleGuiBtn = Instance.new("TextButton")
    ToggleGuiBtn.Name = "ToggleGui"
    ToggleGuiBtn.Size = UDim2.new(0, 50, 0, 50)
    ToggleGuiBtn.Position = UDim2.new(0, 10, 0.5, 0)
    ToggleGuiBtn.BackgroundColor3 = Theme.Accent
    ToggleGuiBtn.Text = "DZ"
    ToggleGuiBtn.TextColor3 = Theme.Text
    ToggleGuiBtn.Font = Enum.Font.GothamBold
    ToggleGuiBtn.Parent = ScreenGui

    local TGCorner = Instance.new("UICorner")
    TGCorner.CornerRadius = UDim.new(1, 0)
    TGCorner.Parent = ToggleGuiBtn

    ToggleGuiBtn.MouseButton1Click:Connect(function()
        MainFrame.Visible = not MainFrame.Visible
    end)
end

-- Execução
pcall(CreateUI)
