-- Estados Globais
getgenv().Darkzin_AutoCoin = false
getgenv().Darkzin_AutoBoss = false
getgenv().Darkzin_HideCoins = false

-- Serviços
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- Função de Injeção Segura (Resolve o problema de não aparecer)
local function SafeParent(gui)
    local targets = {
        game:GetService("CoreGui"),
        LocalPlayer:WaitForChild("PlayerGui"),
        game:GetService("CoreGui"):FindFirstChild("RobloxGui")
    }
    for _, target in pairs(targets) do
        local success = pcall(function()
            gui.Parent = target
        end)
        if success then return true end
    end
    return false
end

local function CreateUI()
    -- Limpeza de instâncias antigas
    for _, v in pairs(game:GetService("CoreGui"):GetChildren()) do
        if v.Name == "DarkzinUltraGui" then v:Destroy() end
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "DarkzinUltraGui"
    ScreenGui.ResetOnSpawn = false
    SafeParent(ScreenGui)

    -- Frame Principal
    local MainFrame = Instance.new("Frame")
